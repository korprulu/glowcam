<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <dev.glowcam.GlPreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/white" />

    <dev.glowcam.FocusRing
        android:id="@+id/focus_ring"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/permission_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/need_permission"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
        <Button
            android:id="@+id/grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/grant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="16dp">

        <HorizontalScrollView
            android:id="@+id/style_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/style_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <dev.glowcam.ZoomControl
            android:id="@+id/zoom"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="@string/zoom" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/thumb"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/thumb_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/gallery"
                android:scaleType="centerCrop" />
            <ImageButton
                android:id="@+id/btn_switch"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/switch_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/switch_camera"
                android:scaleType="center"
                android:src="@drawable/ic_switch_camera" />
            <ImageButton
                android:id="@+id/btn_shutter"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_bg"
                android:contentDescription="@string/shutter" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp">
            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/round_bg"
                android:contentDescription="@string/settings"
                android:scaleType="center"
                android:src="@drawable/ic_settings" />
            <TextView
                android:id="@+id/style_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:singleLine="true"
                android:textColor="@android:color/white"
                android:textSize="16sp" />
            <ImageButton
                android:id="@+id/btn_style"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical|end"
                android:background="@drawable/round_bg"
                android:contentDescription="@string/style"
                android:scaleType="center"
                android:src="@drawable/ic_style" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/style_editor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#E61C1B1B"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editor_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/rename"
            android:drawableEnd="@drawable/ic_edit"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <LinearLayout style="@style/SliderRow">
            <TextView style="@style/SliderLabel" android:text="@string/smooth" />
            <SeekBar android:id="@+id/seek_smooth" style="@style/SliderBar" />
        </LinearLayout>
        <LinearLayout style="@style/SliderRow">
            <TextView style="@style/SliderLabel" android:text="@string/whiten" />
            <SeekBar android:id="@+id/seek_whiten" style="@style/SliderBar" />
        </LinearLayout>
        <LinearLayout style="@style/SliderRow">
            <TextView style="@style/SliderLabel" android:text="@string/rosy" />
            <SeekBar android:id="@+id/seek_rosy" style="@style/SliderBar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btn_editor_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:textColor="#FF6B6B" />
            <Button
                android:id="@+id/btn_editor_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/restore_default" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <Button
                android:id="@+id/btn_editor_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />
            <Button
                android:id="@+id/btn_editor_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
