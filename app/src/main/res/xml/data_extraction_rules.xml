<?xml version="1.0" encoding="utf-8"?>
<!-- Only the user-defined settings (styles) are backed up / transferred; nothing else. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="settings/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="settings/" />
    </device-transfer>
</data-extraction-rules>
